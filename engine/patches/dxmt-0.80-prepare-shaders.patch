+/* Early translation runs at the lowest priority, but the cache's lock is shared with the
+ * time-critical compile threads, so it holds that lock at their priority. */
+struct CacheLockPriority {
+  bool active;
+  explicit CacheLockPriority(bool active) : active(active) {
+    if (active)
+      SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+  }
+  ~CacheLockPriority() {
+    if (active)
+      SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_LOWEST);
+  }
+};
