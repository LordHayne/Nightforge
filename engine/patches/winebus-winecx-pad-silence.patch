 {
     struct bus_event *result = args;
@@ -1206,6 +1240,7 @@ NTSTATUS sdl_bus_wait(void *args)
 
     do
     {
+        pad_silence_update();
         if (bus_event_queue_pop(&event_queue, result)) return STATUS_PENDING;
         if (pSDL_WaitEventTimeout(&event, 10) != 0) process_device_event(&event);
         else check_all_devices_effects_state();
diff --git a/dlls/winebus.sys/pad_silence.h b/dlls/winebus.sys/pad_silence.h
new file mode 100644
index 0000000..c771d84
--- /dev/null
+++ b/dlls/winebus.sys/pad_silence.h
@@ -0,0 +1,76 @@
+/* Nightforge: keeps controller input from the games for as long as Nightforge's overlay asks.
+ *
+ * macOS can't take a pad from the game in front, but in a Windows game everything a pad says comes
+ * through this driver, which runs in winedevice.exe and not in the game. While the overlay is up it
+ * reports a pad at rest, as if the player had let go, and nothing else; afterwards the real state.
+ *
+ * Off unless Nightforge asks. Nightforge writes a time into a Darwin notification's state: silent
+ * until then, on the monotonic clock in nanoseconds. It renews that while the overlay is up, so if
+ * Nightforge hangs or crashes the silence ends by itself and no player sits with a dead pad. The
+ * answer notification tells Nightforge that this driver heard it. */
+
+#ifndef __WINEBUS_PAD_SILENCE_H
+#define __WINEBUS_PAD_SILENCE_H
+
+#include <notify.h>
+#include <stdint.h>
+#include <time.h>
+
+#ifndef PAD_SILENCE_NAME
+#define PAD_SILENCE_NAME "io.github.lordhayne.nightforge.pad-silence"
+#define PAD_SILENCE_ANSWER_NAME "io.github.lordhayne.nightforge.pad-silence.answer"
+#endif
+
+/* Nightforge asks for seconds at a time. A value further off is a mistake, not a request: it must
+ * not leave a player without a pad. */
+#define PAD_SILENCE_LONGEST_NS (30 * 1000000000ull)
+
+enum pad_silence_change { PAD_SILENCE_SAME, PAD_SILENCE_BEGINS, PAD_SILENCE_ENDS };
+
+struct pad_silence
+{
+    int request;
+    int answer;
+    int ready;  /* 0: not registered yet, 1: registered, -1: notifications failed, never silent */
+    int silent;
+    uint64_t until;
+};
+
+static inline int pad_silence_wanted(uint64_t until, uint64_t now)
+{
+    return until > now && until - now <= PAD_SILENCE_LONGEST_NS;
+}
+
+static inline enum pad_silence_change pad_silence_next(struct pad_silence *silence, uint64_t until, uint64_t now)
+{
+    int wanted = pad_silence_wanted(until, now);
+
+    silence->until = until;
+    if (wanted == silence->silent) return PAD_SILENCE_SAME;
+    silence->silent = wanted;
+    return wanted ? PAD_SILENCE_BEGINS : PAD_SILENCE_ENDS;
+}
+
+/* Called often: notify_check only looks at shared memory, the state is fetched when it changed. */
+static inline enum pad_silence_change pad_silence_poll(struct pad_silence *silence)
+{
+    uint64_t now = clock_gettime_nsec_np(CLOCK_MONOTONIC), until = silence->until;
+    int changed = 0;
+
+    if (!silence->ready)
+    {
+        silence->ready = notify_register_check(PAD_SILENCE_NAME, &silence->request) == NOTIFY_STATUS_OK
+                      && notify_register_check(PAD_SILENCE_ANSWER_NAME, &silence->answer) == NOTIFY_STATUS_OK ? 1 : -1;
+    }
+    if (silence->ready < 0) return PAD_SILENCE_SAME;
+
+    if (notify_check(silence->request, &changed) == NOTIFY_STATUS_OK && changed
+        && notify_get_state(silence->request, &until) == NOTIFY_STATUS_OK && pad_silence_wanted(until, now))
+    {
+        notify_set_state(silence->answer, until);
+        notify_post(PAD_SILENCE_ANSWER_NAME);
+    }
+    return pad_silence_next(silence, until, now);
+}
+
+#endif /* __WINEBUS_PAD_SILENCE_H */
