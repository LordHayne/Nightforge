 #ifdef HAVE_SDL_H
 # include <SDL.h>
 #endif
@@ -1196,6 +1197,39 @@ failed:
     return STATUS_UNSUCCESSFUL;
 }
 
+static struct pad_silence pad_silence;
+
+/* Nightforge: when the silence begins every pad reports a pad at rest (a report of zeros: the sticks
+ * centred, triggers and buttons up, the hat in the middle) and then nothing; when it ends, the real
+ * state, which the SDL events have gone on updating. Only reports are held back, rumble still works. */
+static void pad_silence_update(void)
+{
+    enum pad_silence_change change = pad_silence_poll(&pad_silence);
+    struct sdl_device *impl;
+
+    if (change == PAD_SILENCE_SAME) return;
+
+    bus_pad_silent = FALSE;
+    LIST_FOR_EACH_ENTRY(impl, &device_list, struct sdl_device, unix_device.entry)
+    {
+        struct unix_device *iface = &impl->unix_device;
+        struct hid_device_state *state = &iface->hid_device_state;
+        BYTE *neutral;
+
+        if (!impl->started || !state->report_len) continue;
+        if (change == PAD_SILENCE_ENDS)
+        {
+            bus_event_queue_input_report(&event_queue, iface, state->report_buf, state->report_len);
+            continue;
+        }
+        if (!(neutral = calloc(1, state->report_len))) continue;
+        neutral[0] = state->id;
+        bus_event_queue_input_report(&event_queue, iface, neutral, state->report_len);
+        free(neutral);
+    }
+    bus_pad_silent = change == PAD_SILENCE_BEGINS;
+}
+
